# Copy to .env and fill in. .env is gitignored; this file is not, so never put real keys here.

# Parser. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Readwise import (optional). https://readwise.io/access_token
READWISE_TOKEN=

# Hosted site only (Railway). Leave these empty locally: without CLERK_SECRET_KEY the app runs as a local, single-writer tool.
# Clerk: https://dashboard.clerk.com → your app → API keys.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Postgres connection string (Railway sets this when you reference its Postgres service).
DATABASE_URL=
# Encrypts writers' own Anthropic keys. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
# Optional. Defaults: MAX_ACCOUNTS 50, FREE_PARSES 2.
MAX_ACCOUNTS=
FREE_PARSES=
# Owners, comma-separated: no per-writer rate limits, free-parse quota or blurt cap.
ADMIN_EMAILS=
# Buying parses through Stripe (optional; needs the secret key, the webhook secret, and at least one price).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) of the webhook endpoint https://<your site>/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# One-time price (price_…) for a block of parses, and a monthly recurring price for the subscription.
STRIPE_PACK_PRICE_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=
# Optional. Defaults: PACK_PARSES 50 per block, PRO_MONTHLY_PARSES 100 a month on the subscription.
PACK_PARSES=
PRO_MONTHLY_PARSES=
