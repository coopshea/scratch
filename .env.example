# Copy to .env and fill in. .env is gitignored; this file is not, so never put real keys here.

# Parser. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Readwise import (optional). https://readwise.io/access_token
READWISE_TOKEN=

# Hosted site only (Railway). Leave these empty locally: without CLERK_SECRET_KEY the app runs as a local, single-writer tool.
# Clerk: https://dashboard.clerk.com → your app → API keys.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# PostHog: project settings → project token (starts phc_), and the host, e.g. https://us.i.posthog.com.
# Both are public and built into the page. Leave empty to send nothing.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# The site's own address, e.g. https://scratch-production-f4f8.up.railway.app. Clerk then accepts only sessions made for it,
# and Stripe returns writers here.
PUBLIC_URL=
# Postgres connection string (Railway sets this when you reference its Postgres service).
DATABASE_URL=
# Encrypts writers' own Anthropic keys. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
# Optional. Defaults: MAX_ACCOUNTS 50, FREE_PARSES 2.
MAX_ACCOUNTS=
FREE_PARSES=
# Owners, comma-separated: no per-writer rate limits, free-parse quota or blurt cap.
ADMIN_EMAILS=
# Paying in through Stripe (optional). Writers pick the amount, so nothing needs creating in Stripe first.
# Use a restricted key with Checkout Sessions: Write and Customer Portal: Write. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) of the webhook endpoint https://<your site>/stripe/webhook, sending checkout.session.completed,
# invoice.paid, customer.subscription.updated and customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Optional. Parses on the site's key are charged at Anthropic's price times this. Default 1: at cost.
USAGE_MARKUP=
