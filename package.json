{
  "name": "scratch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:offline": "PARSER=offline PORT=5179 tsx server/index.ts",
    "check:readwise": "tsx scripts/check-readwise.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:parse": "tsx scripts/audit-parse.ts",
    "compare:parse": "tsx scripts/compare-parse.ts",
    "dev:watch": "PORT=${PORT:-5180} tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@clerk/express": "^2.1.72",
    "@clerk/react": "^6.17.2",
    "@mantine/core": "^9.6.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@tiptap/pm": "^3.31.3",
    "d3-force": "^3.0.0",
    "dotenv": "^18.0.4",
    "downshift": "^9.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.434.18",
    "posthog-node": "^5.54.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
